{
  "format_version": "1.0",
  "type": "effect",
  "id": "pngtuber_sync",
  "name": "PNGtuber Avatar Sync",
  "version": "1.0.0",
  "description": "Sincroniza el avatar dentro del editor.",
  "parameters": {
    "avatar_closed": {
      "type": "file",
      "label": "Sprite: Boca Cerrada (Normal)",
      "filter": "Images (*.png)"
    },
    "avatar_open": {
      "type": "file",
      "label": "Sprite: Boca Abierta (Hablando)",
      "filter": "Images (*.png)"
    },
    "avatar_blink": {
      "type": "file",
      "label": "Sprite: Parpadeo (Ojos Cerrados)",
      "filter": "Images (*.png)"
    },
    "avatar_talk_blink": {
      "type": "file",
      "label": "Sprite: Hablando + Parpadeo",
      "filter": "Images (*.png)"
    },
    "sensitivity": {
      "type": "float",
      "label": "Umbral de Sensibilidad de Voz",
      "min": 0.0,
      "max": 1.0,
      "default": 0.15
    }
  }
}
